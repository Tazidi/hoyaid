rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.role == 'admin'
          || (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)) != null
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    function canReadSpeciesImage(speciesId) {
      return (
        firestore.get(/databases/(default)/documents/species/$(speciesId)) != null
        && firestore.get(/databases/(default)/documents/species/$(speciesId)).data.isActive == true
      ) || isAdmin();
    }

    function ownsClassificationImage(userId, classificationId) {
      return signedIn()
        && request.auth.uid == userId
        && firestore.get(/databases/(default)/documents/classifications/$(classificationId)) != null
        && firestore.get(/databases/(default)/documents/classifications/$(classificationId)).data.userId == request.auth.uid;
    }

    function canReadClassificationImage(userId, classificationId) {
      return (
        firestore.get(/databases/(default)/documents/classifications/$(classificationId)) != null
        && (
          firestore.get(/databases/(default)/documents/classifications/$(classificationId)).data.status == 'active'
          || ownsClassificationImage(userId, classificationId)
        )
      ) || isAdmin();
    }

    match /species_images/{speciesId}/{fileName} {
      allow read: if canReadSpeciesImage(speciesId);
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /classification_images/{userId}/{classificationId}/{fileName} {
      allow read: if canReadClassificationImage(userId, classificationId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && fileName == 'display_640.jpg'
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && ownsClassificationImage(userId, classificationId)
        && firestore.get(/databases/(default)/documents/classifications/$(classificationId)).data.status == 'pending';
      allow delete: if isAdmin();
    }

    match /dataset_exports/{fileName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /models/{modelVersion}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
